# StayGrid edge: automatic HTTPS for the API, admin panel and every owner website.
# Set ROOT_DOMAIN and ACME_EMAIL in deploy/.env (see .env.example).
{
	email {$ACME_EMAIL}
	# Owner sites (subdomains + owners' own domains) get a certificate on first visit,
	# but only for hosts the backend confirms belong to a website.
	on_demand_tls {
		ask http://backend:3000/api/public/sites/tls-check
	}
}

api.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:3000
}

admin.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:3001
}

# Everything else = an owner website: <name>.{$ROOT_DOMAIN} or a custom domain.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy sites:3002
}

# Redirect plain HTTP to HTTPS (Caddy does this automatically for named sites;
# this catch-all covers on-demand hosts).
http:// {
	redir https://{host}{uri} permanent
}
