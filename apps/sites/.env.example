# Backend API (server-side only; browsers never call it directly)
API_URL=http://localhost:3000/api
# Must match SITES_API_KEY in the backend .env (leave empty in local dev; REQUIRED in production —
# it protects both the backend public-site API and this app's /api/revalidate endpoint)
SITES_API_KEY=
# Local dev only: which host to pretend to be when opening http://localhost:3002
# (e.g. "sharifafarmhouse.staygridbhiwandi.com"). Ignored in production.
DEV_SITE_HOST=
