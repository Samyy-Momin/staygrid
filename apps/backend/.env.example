# API and deployment
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-me@localhost:15432/staygrid?schema=public
CORS_ORIGINS=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Payments. Use live credentials only in the production secret store.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Google Maps Platform (enable Places API, Routes API, and Geocoding API as needed)
GOOGLE_MAPS_API_KEY=replace_me_server_key

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_me@gmail.com
SMTP_PASS=replace_me_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Owner websites
# Root domain for owner sites: <subdomain>.<SITES_ROOT_DOMAIN> (set once the domain is bought)
SITES_ROOT_DOMAIN=staygridbhiwandi.com
# Shared secret between backend and apps/sites (generate: openssl rand -hex 32). Required in production.
SITES_API_KEY=
# Sites app cache-purge endpoint, e.g. http://sites:3002/api/revalidate (internal URL is fine)
SITES_REVALIDATE_URL=

# Expose Swagger at /api/docs in production (default: hidden)
SWAGGER_ENABLED=false
