generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ABANDONED
  COMPLETED
  CANCELLED
  SAVED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Custom fields
  phone         String?
  role          Role      @default(CUSTOMER)
  gender        String?
  age           Int?
  
  // Better Auth relations
  sessions      Session[]
  accounts      Account[]
  
  // App relations
  farmhouses    Farmhouse[]
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  pushTokens    PushToken[]
  notifications Notification[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Farmhouse {
  id            String   @id @default(uuid())
  title         String
  price12Hours  Float    @default(0)
  price24Hours  Float    @default(0)
  capacity      Int      @default(1)
  maxIncludedGuests Int?
  extraGuestFee     Float?
  photos        String[]
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isCoupleFriendly Boolean @default(false)
  isPetFriendly    Boolean @default(false)
  
  // Location
  streetAddress String?
  city          String?
  state         String?
  country       String?  @default("India")
  postalCode    String?
  latitude      Float?
  longitude     Float?
  
  contactNumbers String[]
  tokenAmount    Float    @default(2000)
  isWheelchairAccessible Boolean @default(false)
  
  // Outdoor
  hasPool       Boolean  @default(false)
  poolType      String?  // "ATTACHED" | "SEPARATE"
  poolSize      String?
  babyPoolSize  String?
  hasTurf       Boolean  @default(false)
  hasRainDance  Boolean  @default(false)
  hasPlayArea   Boolean  @default(false)
  hasGardenArea Boolean  @default(false)
  hasGazebo     Boolean  @default(false)
  hasCelebrationArea Boolean @default(false)

  // Indoor (Rooms)
  roomCount      Int      @default(1)
  acRoomCount    Int      @default(0)
  nonAcRoomCount Int      @default(0)
  hallCount      Int      @default(0)
  
  // Beds & Furniture
  singleBedCount Int      @default(0)
  doubleBedCount Int      @default(0)
  extraMattressCount Int  @default(0)
  sofaCount      Int      @default(0)
  balconyCount   Int      @default(0)
  terraceCount   Int      @default(0)
  
  // Kitchen
  hasKitchen    Boolean  @default(false)
  hasFridge     Boolean  @default(false)
  hasRoWater    Boolean  @default(false)
  hasBbq        Boolean  @default(false)
  hasGas        Boolean  @default(false)
  gasCharge     Float?
  
  // Indoor Games
  hasCarom      Boolean  @default(false)
  hasChess      Boolean  @default(false)
  has8BallPool  Boolean  @default(false)
  hasCricket    Boolean  @default(false)
  hasBadminton  Boolean  @default(false)
  
  // Electronics
  hasTv         Boolean  @default(false)
  hasSpeakers   Boolean  @default(false)
  hasMicrophone Boolean  @default(false)
  hasWifi       Boolean  @default(false)
  
  // Custom
  customAmenities String[]
  hostName        String?
  
  // Rating (denormalized)
  avgRating     Float    @default(0)
  reviewCount   Int      @default(0)

  isBestMatch   Boolean  @default(false)
  isTrusted     Boolean  @default(false)
  defaultCommissionPercentage Float @default(20.0)

  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings         Booking[]
  blockedDates     BlockedDateRange[]
  offers           Offer[]
  reviews          Review[]
  favorites        Favorite[]
  pricingOverrides PricingOverride[]
  exploreMedia     ExploreMedia[]

  @@map("farmhouse")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  iconName  String?  // fallback icon name from lucide
  imageUrl  String?  // uploaded image URL
  filterKey String   // the key used to filter (e.g., hasPool)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("category")
}

model HeroBanner {
  id          String   @id @default(uuid())
  heading     String
  subheading  String?
  buttonText  String?
  imageUrl    String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_banner")
}

model Review {
  id             String    @id @default(uuid())
  rating         Int       @default(5)
  comment        String?
  groupType      String?   // "Couple" | "Family" | "Friends Group" | "Solo"
  amenityRatings Json?     // e.g. { pool: 5, cleanliness: 5, turf: 4, hospitality: 5 }
  
  farmhouseId String
  farmhouse   Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("review")
}

model Favorite {
  id          String    @id @default(uuid())
  
  farmhouseId String
  farmhouse   Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@unique([userId, farmhouseId])
  @@map("favorite")
}

model Offer {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  
  farmhouseId String
  farmhouse   Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("offer")
}

model BlockedDateRange {
  id          String   @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  note        String?
  
  farmhouseId String
  farmhouse   Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String   @id @default(uuid())
  checkIn         DateTime
  checkOut        DateTime
  adults          Int
  children        Int
  totalAmount     Float
  tokenPaid       Float
  status          BookingStatus @default(PENDING_PAYMENT)
  notes           String?
  razorpayOrderId String?
  razorpayPaymentId String?

  // Financial Accounting & Commission (20% default or custom)
  commissionPercentage     Float     @default(20.0)
  staygridNetCommission    Float     @default(0.0)
  ownerShareAmount         Float     @default(0.0)
  ownerPayoutAmount        Float?
  ownerPayoutStatus        String    @default("PENDING") // "PENDING" | "PAID" | "HOLD"
  ownerPayoutTxnId         String?
  ownerPaidAt              DateTime?

  // Cancellation & Refund Override
  cancellationReason      String?
  policyRecommendedRefund Float?
  refundAmount            Float?
  isCustomRefundOverride  Boolean   @default(false)
  refundOverrideReason    String?
  refundStatus            String?   // "PENDING" | "PROCESSED" | "NONE"
  refundTxnId             String?
  cancelledAt             DateTime?

  // Cash payment dual confirmation
  cashPaymentConfirmedByOwner Boolean @default(false)
  cashPaymentConfirmedByUser  Boolean @default(false)
  paymentMethod               String? // "ONLINE" | "CASH"

  // Accounting Ledger Closure
  accountingStatus        String    @default("UNCLOSED") // "UNCLOSED" | "BALANCED_CLOSED"

  // Terms acceptance
  termsAcceptedAt DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  farmhouseId String
  farmhouse   Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key         String   @id // e.g., "FEATURED_CONTACT_NUMBER"
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

model PricingOverride {
  id           String    @id @default(uuid())
  farmhouseId  String
  farmhouse    Farmhouse @relation(fields: [farmhouseId], references: [id], onDelete: Cascade)
  date         DateTime
  price12Hours Float?
  price24Hours Float?
  label        String?
  type         String    // "WEEKEND" | "FESTIVAL" | "CUSTOM"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([farmhouseId, date])
  @@map("pricing_override")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String?  @unique
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  @@map("push_token")
}

model FinancialTransaction {
  id           String   @id @default(uuid())
  bookingId    String
  type         String   // "CUSTOMER_TOKEN" | "OWNER_CASH_COLLECTION" | "COMMISSION_OVERRIDE" | "OWNER_SETTLEMENT" | "OWNER_PAYMENT_RECEIVED" | "CUSTOMER_REFUND"
  amount       Float
  direction    String   // "INFLOW" | "OUTFLOW" | "ADJUSTMENT"
  fromEntity   String   // "CUSTOMER" | "STAYGRID" | "OWNER"
  toEntity     String   // "STAYGRID" | "OWNER" | "CUSTOMER"
  reference    String?  // UTR number or Razorpay Payment ID
  reason       String?  // Reason for commission change or custom refund
  notes        String?
  performedBy  String?  // Admin User ID / System
  createdAt    DateTime @default(now())

  @@map("financial_transaction")
}

model ExploreMedia {
  id               String     @id @default(uuid())
  type             String     // "REEL" | "PHOTO"
  mediaUrl         String     // Video MP4 URL or High-Res Image URL
  thumbnailUrl     String?    // Video poster image
  instagramPostUrl String?    // Direct link to Instagram post
  caption          String?
  viewCount        Int        @default(0)
  isFeatured       Boolean    @default(false)
  farmhouseId      String?
  farmhouse        Farmhouse? @relation(fields: [farmhouseId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())

  @@map("explore_media")
}

model UserEvent {
  id          String   @id @default(uuid())
  userId      String?
  farmhouseId String?
  eventType   String   // "VIEW_FARMHOUSE" | "INITIATE_CHECKOUT" | "ABANDON_CHECKOUT"
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("user_event")
}

model MarketingCampaign {
  id        String   @id @default(uuid())
  title     String
  segment   String   // "ALL" | "ABANDONED_CHECKOUT" | "UPCOMING_3DAYS" | "INACTIVE_60DAYS"
  message   String
  sentCount Int      @default(0)
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  @@map("marketing_campaign")
}
